# Node backend chạy song song backend C# trong giai đoạn migration.
# Không commit mật khẩu thật.
DATABASE_URL="mysql://kaitokid:CHANGE_ME@127.0.0.1:3306/kaitokid"
PORT=5300
DATABASE_CONNECTION_LIMIT=5
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:8081,http://127.0.0.1:5173,http://127.0.0.1:8081"

# Phải trùng Jwt:* của backend C# trong giai đoạn chạy song song.
# Không commit secret thật.
JWT_KEY="CHANGE_ME"
JWT_ISSUER="KaitoKid.API.Auth"
JWT_AUDIENCE="KaitoKid.Client"

# Upload avatar/review của Node. Bỏ trống để dùng apps/api/public.
# PUBLIC_ROOT="C:/path/to/public"


# Trong giai đoạn chạy song song C# + Node, C# vẫn là owner của sweeper.
# Chỉ bật true sau khi đã dừng CartReservationSweeper bên C# ở cutover.
CART_SWEEPER_ENABLED=false
CART_SWEEP_INTERVAL_SECONDS=60


# Payment expiry: C# vẫn là owner trong coexistence.
PAYMENT_SWEEPER_ENABLED=false
PAYMENT_SWEEP_INTERVAL_SECONDS=30
# Chỉ bật mô phỏng paid ở local/dev có chủ đích.
PAYMENT_ALLOW_SIMULATE_PAID=false

# Shipping fee provider fallback. Token thật ưu tiên cấu hình DB CauHinhCuaHang.
GHN_BASE_URL="https://dev-online-gateway.ghn.vn"
GHN_FROM_DISTRICT_ID="1442"
GHN_TO_DISTRICT_ID_FALLBACK="1454"
GHN_TO_WARD_CODE_FALLBACK="21211"
GHTK_BASE_URL="https://services.giaohangtietkiem.vn"
