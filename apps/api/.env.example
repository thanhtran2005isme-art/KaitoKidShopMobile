# KaitoKid Node backend — production/runtime source of truth.
# Không commit mật khẩu, token hoặc API key thật.
DATABASE_URL="mysql://kaitokid:CHANGE_ME@127.0.0.1:3306/kaitokid"
PORT=5300
DATABASE_CONNECTION_LIMIT=5
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:8081,http://127.0.0.1:5173,http://127.0.0.1:8081"

JWT_KEY="CHANGE_ME"
JWT_ISSUER="KaitoKid.API.Auth"
JWT_AUDIENCE="KaitoKid.Client"
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# Upload/static media. Bỏ trống PUBLIC_ROOT để dùng apps/api/public.
# PUBLIC_ROOT="C:/path/to/public"
# Shared media hiện có của Web; mặc định auto-resolve apps/web/public.
# SHARED_WEB_PUBLIC_ROOT="C:/path/to/KaitoKidShop/apps/web/public"

# Node là owner duy nhất sau khi retire C#.
# Biến này được giữ để tương thích script/deploy cũ; giá trị runtime hợp lệ là node.
BACKGROUND_WORKER_OWNER=node
CART_SWEEPER_ENABLED=true
CART_SWEEP_INTERVAL_SECONDS=60
PAYMENT_SWEEPER_ENABLED=true
PAYMENT_SWEEP_INTERVAL_SECONDS=30
PAYMENT_ALLOW_SIMULATE_PAID=false
SHIPPING_SIMULATOR_ENABLED=true
SHIPPING_SIMULATOR_STEP_MINUTES=1
SHIPPING_SIMULATOR_INTERVAL_SECONDS=30
CHAT_IDLE_SWEEPER_ENABLED=true
CHAT_SWEEP_INTERVAL_SECONDS=120
CHAT_IDLE_MINUTES=30
IMAGE_INDEXER_ENABLED=false
IMAGE_REINDEX_INTERVAL_SECONDS=600

# VietQR: danh sách ngân hàng dùng API public; tra cứu tên chủ tài khoản cần credential.
# Lấy Client ID / API Key tại My VietQR và chỉ lưu ở backend/deployment secrets.
VIETQR_BASE_URL="https://api.vietqr.io/v2"
# VIETQR_CLIENT_ID=
# VIETQR_API_KEY=

# Shipping provider fallback. Token thật ưu tiên cấu hình secret/DB.
GHN_BASE_URL="https://dev-online-gateway.ghn.vn"
GHN_FROM_DISTRICT_ID="1442"
GHN_TO_DISTRICT_ID_FALLBACK="1454"
GHN_TO_WARD_CODE_FALLBACK="21211"
GHTK_BASE_URL="https://services.giaohangtietkiem.vn"
# GHN_TOKEN=
# GHN_SHOP_ID=
# GHTK_TOKEN=
# GHTK_PICK_PROVINCE=
# GHTK_PICK_DISTRICT=

# Lalamove: credentials chỉ để ở backend env, không lưu/hiển thị trên Admin Web.
# Sandbox: https://rest.sandbox.lalamove.com
# Production: https://rest.lalamove.com
LALAMOVE_BASE_URL="https://rest.sandbox.lalamove.com"
LALAMOVE_MARKET="VN"
LALAMOVE_SERVICE_TYPE="MOTORCYCLE"
# Webhook signature dùng đúng pathname public mà Lalamove gọi tới backend.
LALAMOVE_WEBHOOK_PATH="/api/shipping/lalamove/webhook"
# Có thể cấu hình địa chỉ kho ở Admin Shipping; biến này là fallback nếu cần.
# LALAMOVE_PICKUP_ADDRESS="Số nhà, phường/xã, quận/huyện, tỉnh/thành"
# LALAMOVE_API_KEY=pk_test_...
# LALAMOVE_API_SECRET=sk_test_...

AUTH_REQUIRE_OTP_FOR_REGISTER=false
AUTH_REQUIRE_RECAPTCHA=false
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_REGISTRATION_VERIFICATION_HOURS=24
AUTH_EMAIL_VERIFY_URL="http://localhost:5173/verify-email"
AUTH_RESET_PASSWORD_URL="http://localhost:5173/reset-password"

# Email: để trống API key => local mock in link ra console.
# EMAIL_BREVO_API_KEY=
EMAIL_BREVO_SENDER_EMAIL="noreply@kaitokid.local"
EMAIL_BREVO_SENDER_NAME="KaitoKid Shop"

# reCAPTCHA v3. Secret trống => dev mode bỏ qua verify.
# RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# OAuth identifiers/secrets cấu hình local/deploy.
# Google Client ID là public identifier, giữ mặc định parity với C# cũ và Mobile/Web.
# Deploy có thể override bằng biến môi trường GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID="609254164052-81mv1bn2kegd4nmic386q1fdv3o5oviq.apps.googleusercontent.com"
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

FRONTEND_BASE_URL="http://localhost:5173"

CHAT_RATE_LIMIT_PER_WINDOW=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=10
CHAT_MAX_BOT_FAIL_BEFORE_HANDOFF=2
# CHAT_LLM_API_KEY=
# CHAT_LLM_ENDPOINT=
CHAT_LLM_MODEL="gemini-2.0-flash"

IMAGE_SEARCH_ENABLED=true
IMAGE_SEARCH_MODEL_PATH="Models/clip-image-encoder.onnx"
IMAGE_SEARCH_MODEL_NAME="clip-vit-base-patch32"
IMAGE_SEARCH_INPUT_SIZE=224
IMAGE_SEARCH_MIN_SIMILARITY=0.15
IMAGE_SEARCH_MAX_RESULTS=48
IMAGE_SEARCH_MAX_UPLOAD_BYTES=8388608
# PUBLIC_ASSET_BASE_URL="http://localhost:5300"
PUBLIC_WEB_BASE_URL="http://localhost:5173"
