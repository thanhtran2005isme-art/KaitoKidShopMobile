# Node backend chạy song song backend C# trong giai đoạn migration.
# Không commit mật khẩu thật.
DATABASE_URL="mysql://kaitokid:CHANGE_ME@127.0.0.1:3306/kaitokid"
PORT=5300
DATABASE_CONNECTION_LIMIT=5
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:8081,http://127.0.0.1:5173,http://127.0.0.1:8081"

# Phải trùng Jwt:* của backend C# trong giai đoạn chạy song song.
# Không commit secret thật.
JWT_KEY="CHANGE_ME"
JWT_ISSUER="KaitoKid.API.Auth"
JWT_AUDIENCE="KaitoKid.Client"

# Upload avatar/review của Node. Bỏ trống để dùng apps/api/public.
# PUBLIC_ROOT="C:/path/to/public"
# Shared static media của Web, mặc định auto-resolve apps/web/public.
# SHARED_WEB_PUBLIC_ROOT="C:/path/to/KaitoKidShop/apps/web/public"

# Master ownership guard cho background workers.
# Giữ csharp trong coexistence. Chỉ chuyển node khi C# worker đã dừng.
BACKGROUND_WORKER_OWNER=csharp

# Cart reservation sweeper.
CART_SWEEPER_ENABLED=false
CART_SWEEP_INTERVAL_SECONDS=60

# Payment expiry sweeper.
PAYMENT_SWEEPER_ENABLED=false
PAYMENT_SWEEP_INTERVAL_SECONDS=30
# Chỉ bật mô phỏng paid ở local/dev có chủ đích.
PAYMENT_ALLOW_SIMULATE_PAID=false

# Shipping status simulator parity với C#.
SHIPPING_SIMULATOR_ENABLED=false
SHIPPING_SIMULATOR_STEP_MINUTES=1
SHIPPING_SIMULATOR_INTERVAL_SECONDS=30

# Shipping fee provider fallback. Token thật ưu tiên cấu hình DB CauHinhCuaHang.
GHN_BASE_URL="https://dev-online-gateway.ghn.vn"
GHN_FROM_DISTRICT_ID="1442"
GHN_TO_DISTRICT_ID_FALLBACK="1454"
GHN_TO_WARD_CODE_FALLBACK="21211"
GHTK_BASE_URL="https://services.giaohangtietkiem.vn"
# GHN_TOKEN=
# GHN_SHOP_ID=
# GHTK_TOKEN=
# GHTK_PICK_PROVINCE=
# GHTK_PICK_DISTRICT=

# Phase 8 Auth — defaults tương thích API.Auth C#.
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7
AUTH_REQUIRE_OTP_FOR_REGISTER=false
AUTH_REQUIRE_RECAPTCHA=false
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_REGISTRATION_VERIFICATION_HOURS=24
AUTH_EMAIL_VERIFY_URL="http://localhost:5173/verify-email"
AUTH_RESET_PASSWORD_URL="http://localhost:5173/reset-password"

# Email: để trống API key => mock email in ra console local.
# Không commit secret thật.
# EMAIL_BREVO_API_KEY=
EMAIL_BREVO_SENDER_EMAIL="noreply@kaitokid.local"
EMAIL_BREVO_SENDER_NAME="KaitoKid Shop"

# reCAPTCHA v3. Secret trống => dev mode bỏ qua verify.
# RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# OAuth identifiers/secrets phải cấu hình local/deploy, không commit secret.
# GOOGLE_CLIENT_ID=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# Link theo dõi trong email order.
FRONTEND_BASE_URL="http://localhost:5173"

# Phase 9 realtime/chat. Ngoài flag này, BACKGROUND_WORKER_OWNER cũng phải = node.
CHAT_IDLE_SWEEPER_ENABLED=false
CHAT_SWEEP_INTERVAL_SECONDS=120
CHAT_IDLE_MINUTES=30
CHAT_RATE_LIMIT_PER_WINDOW=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=10
CHAT_MAX_BOT_FAIL_BEFORE_HANDOFF=2

# LLM chatbot optional. Trống => rule-based bot.
# CHAT_LLM_API_KEY=
# CHAT_LLM_ENDPOINT=
CHAT_LLM_MODEL="gemini-2.0-flash"

# Image search CLIP/ONNX.
IMAGE_SEARCH_ENABLED=true
# Image indexer chỉ chạy khi cả IMAGE_INDEXER_ENABLED=true và BACKGROUND_WORKER_OWNER=node.
IMAGE_INDEXER_ENABLED=false
IMAGE_REINDEX_INTERVAL_SECONDS=600
IMAGE_SEARCH_MODEL_PATH="Models/clip-image-encoder.onnx"
IMAGE_SEARCH_MODEL_NAME="clip-vit-base-patch32"
IMAGE_SEARCH_INPUT_SIZE=224
IMAGE_SEARCH_MIN_SIMILARITY=0.15
IMAGE_SEARCH_MAX_RESULTS=48
IMAGE_SEARCH_MAX_UPLOAD_BYTES=8388608
# PUBLIC_ASSET_BASE_URL="http://localhost:5300"

# URL public dùng cho sitemap/robots.
PUBLIC_WEB_BASE_URL="http://localhost:5173"
