{
  "name": "@kaitokid/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "prisma generate && nest start --watch",
    "db:introspect": "prisma db pull && prisma generate",
    "db:generate": "prisma generate",
    "db:audit": "npm run build && node dist/scripts/audit-legacy-db.js",
    "test:catalog": "npm run build && node --test test/catalog-contract.test.mjs",
    "test:customer-aux": "npm run build && node --test test/customer-aux-contract.test.mjs",
    "test:cart-reservation": "npm run build && node --test test/cart-reservation-contract.test.mjs",
    "test:checkout-order": "npm run build && node --test test/checkout-order-contract.test.mjs",
    "test:auth-rbac": "npm run build && node --test test/auth-rbac-contract.test.mjs",
    "test:realtime-cutover": "npm run build && node --test test/realtime-cutover-contract.test.mjs",
    "test:admin-migration": "npm run build && node --test test/admin-migration-contract.test.mjs",
    "test:final-cutover": "npm run build && node --test test/final-cutover-contract.test.mjs test/realtime-runtime-contract.test.mjs",
    "smoke:final-cutover": "node --test test/final-runtime-smoke.test.mjs",
    "test:protected-runtime": "node --test test/protected-runtime-parity.test.mjs",
    "test:concurrency-runtime": "npm run build && node test/run-concurrency-runtime-race.mjs",
    "test:realtime-runtime": "npm run build && node --test test/realtime-runtime-race.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.2.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "bcryptjs": "^3.0.2",
    "@nestjs/websockets": "11.2.5",
    "@nestjs/platform-socket.io": "11.2.5",
    "socket.io": "^4.8.1",
    "onnxruntime-node": "^1.22.0",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.7",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "prisma": "7.10.0",
    "socket.io-client": "^4.8.1",
    "typescript": "~5.9.3"
  }
}
