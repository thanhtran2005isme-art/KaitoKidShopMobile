# Không cần tạo .env khi chạy development thông thường.
# Expo tự phát hiện IPv4 LAN của máy chạy Metro và dùng API.Customer tại cổng 5265.
#
# Chỉ bỏ comment dòng dưới nếu muốn ép app dùng một backend khác:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:5265

# Google OAuth Web Client ID là public identifier, không phải client secret.
# Có thể override client ID mặc định nếu đổi project OAuth:
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=609254164052-81mv1bn2kegd4nmic386q1fdv3o5oviq.apps.googleusercontent.com
